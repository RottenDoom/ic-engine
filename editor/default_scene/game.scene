#default_scene/default.scene
scene:
  name: "Game Scene"
  # skybox: "assets/cubemap/sky_01"

entities:
  - id: 1
    name: "Player"
    components:
      TransformComponent:
        position: [0.0, 0.0, 0.0]
        rotation: [1.0, 0.0, 0.0, 0.0]
        scale:    [1.0, 1.0, 1.0]
      MeshComponent:
        model: "player_model" # asset registry nam
  - id: 2
    name: "Cube"
    components:
      TransformComponent:
        position: [15.0, 15.0, 0.0]
        rotation: [1.0, 0.0, 0.0, 0.0]
        scale:    [1.0, 1.0, 1.0]
      MeshComponent:
        model: "cube_model"
  - id: 3
    name: "Tree"
    components:
      TransformComponent:
        position: [50.0, 50.0, 0.0]
        rotation: [1.0, 0.0, 0.0, 0.0]
        scale:    [1.0, 1.0, 1.0]
      MeshComponent:
        model: "tree_house_model"
